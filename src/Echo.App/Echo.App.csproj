    <UseWPF>true</UseWPF>
    <AssemblyName>Echo</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../../assets/brand/echo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Echo.Core/Echo.Core.csproj" />
