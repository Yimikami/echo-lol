<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Echo.App.Controls" xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Class="Echo.App.MainWindow" Title="Echo" Width="1480" Height="920" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource StudioFont}" PreviewKeyDown="WindowKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
  </shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="#353841" BorderThickness="1" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="ShellRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="TitleBar" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="#2B2E35" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragHeader">
        <Grid Margin="20,0,9,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/echo-emblem.png" Width="25" Height="25"/>
            <TextBlock Text="Echo" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Background="#22262E" CornerRadius="14" Padding="12,6" VerticalAlignment="Center" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#C2D4FF" Margin="0,0,8,0"/>
              <TextBlock x:Name="HeaderStatus" Text="Connecting to capture" FontSize="12" Foreground="#D7DEEF"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Click="MinimizeClick" AutomationProperties.Name="Minimize">
              <local:PhosphorIcon Kind="Minimize" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="MaximizeClick" AutomationProperties.Name="Maximize">
              <local:PhosphorIcon Kind="Maximize" Width="14" Height="14"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="CloseClick" ToolTip="Close library; automatic capture keeps running" AutomationProperties.Name="Close library">
              <local:PhosphorIcon Kind="Close" Width="18" Height="18"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock x:Name="ErrorBanner" Grid.Row="1" Grid.ColumnSpan="2" Background="#3D262B" Foreground="#FFC2CC" Padding="20,10" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
              <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Border x:Name="Sidebar" Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="#2B2E35" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,19,0,0">
            <Button x:Name="LibraryNav" Style="{StaticResource RailButton}" Click="LibraryClick" AutomationProperties.Name="Library">
              <StackPanel>
                <local:PhosphorIcon Kind="Library" Width="23" Height="23" HorizontalAlignment="Center"/>
                <TextBlock Text="Library" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="MatchesNav" Style="{StaticResource RailButton}" Click="MatchesClick" AutomationProperties.Name="Matches">
              <StackPanel>
                <local:PhosphorIcon Kind="Matches" Width="23" Height="23" HorizontalAlignment="Center"/>
                <TextBlock Text="Matches" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="SettingsNav" Style="{StaticResource RailButton}" Click="SettingsClick" AutomationProperties.Name="Settings">
              <StackPanel>
                <local:PhosphorIcon Kind="Settings" Width="23" Height="23" HorizontalAlignment="Center"/>
                <TextBlock Text="Settings" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,0,0,19">
            <Button Style="{StaticResource RailButton}" Click="SaveMomentClick" ToolTip="Save a manual moment during the match" AutomationProperties.Name="Save moment">
              <local:PhosphorIcon Kind="Bookmark" Width="22" Height="22"/>
            </Button>
            <Border BorderBrush="#30333B" BorderThickness="0,1,0,0" Margin="17,10,17,13"/>
            <Button x:Name="CaptureButton" Style="{StaticResource RailButton}" Click="CaptureClick" ToolTip="Automatic capture is on. Click to pause." AutomationProperties.Name="Automatic capture controls">
              <StackPanel>
                <local:PhosphorIcon x:Name="CaptureGlyph" Kind="Recording" Width="22" Height="22" Foreground="#C2D4FF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RecorderLabel" Text="Auto on" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="LibraryPanel" Grid.Row="2" Grid.Column="1" Margin="32,28,32,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="42"/>
        </Grid.RowDefinitions>
        <Grid x:Name="LibraryHeading">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="280"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Library" FontSize="30" FontWeight="Bold"/>
            <TextBlock x:Name="LibraryCount" Text="Your best moments, saved automatically." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="#333740" BorderThickness="1" CornerRadius="8" Height="40" VerticalAlignment="Center">
            <DockPanel Margin="11,0">
              <local:PhosphorIcon Kind="Search" Width="17" Height="17" Foreground="{DynamicResource SecondaryBrush}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
              <Grid>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0,9" TextChanged="SearchChanged" AutomationProperties.Name="Search clips"/>
                <TextBlock Text="Search clips" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,25,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="FilterAll" Content="All moments" Tag="All" Click="FilterClick" Padding="14,8" Margin="0,0,8,0"/>
            <Button x:Name="FilterKills" Tag="Kill" Click="FilterClick" Padding="15,8" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <local:PhosphorIcon Kind="Kill" Width="16" Height="16"/>
                <TextBlock Text="Kills" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="FilterAssists" Tag="Assist" Click="FilterClick" Padding="15,8" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <local:PhosphorIcon Kind="Assist" Width="16" Height="16"/>
                <TextBlock Text="Assists" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="FilterDeaths" Tag="Death" Click="FilterClick" Padding="15,8">
              <StackPanel Orientation="Horizontal">
                <local:PhosphorIcon Kind="Death" Width="16" Height="16"/>
                <TextBlock Text="Deaths" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <ComboBox x:Name="SortBox" Grid.Column="1" Width="150" SelectedIndex="0" SelectionChanged="SortChanged" AutomationProperties.Name="Sort clips">
            <ComboBoxItem Content="Newest first"/>
            <ComboBoxItem Content="Oldest first"/>
          </ComboBox>
        </Grid>
        <Grid Grid.Row="2" x:Name="ClipBrowser">
          <ListBox x:Name="ClipList" SelectionChanged="ClipSelected" SizeChanged="GalleryWidthChanged" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Clip gallery">
            <ListBox.Resources>
              <sys:Double x:Key="GalleryTileWidth">300</sys:Double>
              <sys:Double x:Key="GalleryThumbnailHeight">168</sys:Double>
            </ListBox.Resources>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Width" Value="{DynamicResource GalleryTileWidth}"/>
                <Setter Property="Margin" Value="0,0,16,22"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Card" Background="Transparent" CornerRadius="9" Padding="5" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Card" Property="Background" Value="#1E2127"/>
                          <Setter TargetName="Card" Property="BorderBrush" Value="#4B5569"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="Card" Property="BorderBrush" Value="#C2D4FF"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid Height="{DynamicResource GalleryThumbnailHeight}">
                    <Border Background="#22252B" CornerRadius="7">
                      <local:PhosphorIcon Kind="Matches" Width="32" Height="32" Foreground="#5B6475" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="7">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                      </Border.Background>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#E20B0D11" CornerRadius="4" Padding="7,4" Margin="9">
                      <TextBlock Text="{Binding DurationLabel}" FontSize="12" Foreground="White"/>
                    </Border>
                    <Border Background="#E3232B38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Padding="7,4" CornerRadius="4" Visibility="{Binding StateVisibility}">
                      <TextBlock Text="{Binding StateLabel}" FontSize="12" Foreground="#F6F8FC"/>
                    </Border>
                  </Grid>
                  <Grid Margin="2,12,2,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Visibility="{Binding KillVisibility}" Margin="9,0,0,0">
                        <local:PhosphorIcon Kind="Kill" Width="15" Height="15" Foreground="#BAD2FF"/>
                        <TextBlock Text="{Binding KillCount}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="#BAD2FF"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding DeathVisibility}" Margin="9,0,0,0">
                        <local:PhosphorIcon Kind="Death" Width="15" Height="15" Foreground="#FFBBCB"/>
                        <TextBlock Text="{Binding DeathCount}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="#FFBBCB"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding AssistVisibility}" Margin="9,0,0,0">
                        <local:PhosphorIcon Kind="Assist" Width="15" Height="15" Foreground="#A3E6D3"/>
                        <TextBlock Text="{Binding AssistCount}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="#A3E6D3"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding ManualVisibility}" Margin="9,0,0,0">
                        <local:PhosphorIcon Kind="Bookmark" Width="15" Height="15" Foreground="#D0D7E4"/>
                        <TextBlock Text="{Binding ManualCount}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="#D0D7E4"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding ShortDate}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="2,6,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyGallery" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
            <local:PhosphorIcon Kind="Matches" Width="50" Height="50" Foreground="#727E95" HorizontalAlignment="Center"/>
            <TextBlock Text="Your next play starts here" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,10"/>
            <TextBlock x:Name="EmptyList" Text="Keep Echo running and play League. Your kills, assists and deaths will appear here automatically." Style="{StaticResource Hint}" TextAlignment="Center"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="3,7,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock x:Name="PageLabel" Text="Page 1 of 1" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="PreviousPageButton" Style="{StaticResource IconButton}" Click="PreviousPageClick" ToolTip="Previous page" AutomationProperties.Name="Previous page">
              <local:PhosphorIcon Kind="Previous" Width="17" Height="17"/>
            </Button>
            <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" Click="NextPageClick" ToolTip="Next page" AutomationProperties.Name="Next page">
              <local:PhosphorIcon Kind="Next" Width="17" Height="17"/>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
      <Grid x:Name="EditorPanel" Grid.Row="2" Grid.Column="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="70"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <Border x:Name="SelectedHeading" BorderBrush="#30333B" BorderThickness="0,0,0,1" Padding="20,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="BackToLibraryClick" VerticalAlignment="Center" ToolTip="Back to library (Esc)" AutomationProperties.Name="Back to library">
              <local:PhosphorIcon Kind="Back"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock x:Name="SelectedTitle" Text="Clip editor" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="SelectedDetails" Text="Select a recording" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="QuickInputsButton" Style="{StaticResource QuietButton}" Click="TogglePlaybackInputs" ToolTip="Show or hide keyboard and mouse"><local:PhosphorIcon Kind="Keyboard" Width="20" Height="20"/></Button>
              <Button x:Name="QuickExportButton" Content="Export" Style="{StaticResource AccentButton}" Click="ExportClick" Margin="0,0,12,0"/>
              <Button x:Name="EditTrimButton" Style="{StaticResource QuietButton}" Click="ToggleTrimClick" Margin="0,0,12,0" AutomationProperties.Name="Toggle trimming">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Scissors" Width="18" Height="18"/>
                  <TextBlock x:Name="TrimButtonLabel" Text="Trim" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="RevealButton" Style="{StaticResource IconButton}" Click="RevealClick" ToolTip="Show in folder" AutomationProperties.Name="Show in folder">
                <local:PhosphorIcon Kind="Folder" Width="19" Height="19"/>
              </Button>
              <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Click="DeleteClick" ToolTip="Delete clip" AutomationProperties.Name="Delete clip">
                <local:PhosphorIcon Kind="Delete" Width="19" Height="19"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="Editor" Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="InspectorColumn" Width="0"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="PlayerDock">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="136"/>
              <RowDefinition Height="58"/>
            </Grid.RowDefinitions>
            <Border x:Name="VideoSurface" Background="#08090B" Margin="24,20,24,0" CornerRadius="5" MouseLeftButtonDown="VideoClicked">
              <Grid>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaOpened="MediaOpened" MediaEnded="MediaEnded" MediaFailed="MediaFailed"/>
                <Image x:Name="PlayerPoster" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Canvas x:Name="InputCanvas" ClipToBounds="True" SizeChanged="InputCanvasResized" MouseMove="InputCanvasHover" MouseLeave="InputCanvasLeave">
                  <local:InputOverlay x:Name="PlaybackInputs" Cursor="SizeAll" MouseLeftButtonDown="InputLayerDown" MouseMove="InputLayerMove" MouseLeftButtonUp="InputLayerUp" Visibility="Collapsed"/>
                  <Border x:Name="InputLayerOutline" BorderBrush="#A9C9FF" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False" Visibility="Collapsed"/>
                  <Button x:Name="InputCollapseButton" Width="24" Height="22" MinHeight="20" Padding="0" Content="−" Click="CollapsePlaybackInputs" ToolTip="Collapse or expand overlay" Visibility="Collapsed"/>
                  <Thumb x:Name="InputResizeGrip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="14" Height="14" Cursor="SizeNWSE" DragStarted="InputResizeStarted" DragDelta="InputResizeDelta" DragCompleted="InputResizeCompleted" Visibility="Collapsed"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#A9C9FF" BorderBrush="#17243A" BorderThickness="2" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb>
                </Canvas>
                <StackPanel x:Name="EmptyPlayer" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <local:PhosphorIcon Kind="Play" Width="40" Height="40" Foreground="#7182A2" HorizontalAlignment="Center"/>
                  <TextBlock Text="Choose a clip to preview" FontSize="18" Margin="0,20,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="24,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Click="JumpBackClick" ToolTip="Back 5 seconds" AutomationProperties.Name="Seek backward">
                  <local:PhosphorIcon Kind="Previous" Width="17" Height="17"/>
                </Button>
                <Button x:Name="PlayButton" Width="42" Height="38" Padding="10,8" Style="{StaticResource AccentButton}" Click="PlayClick" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause">
                  <local:PhosphorIcon x:Name="PlayIcon" Kind="Play" Width="17" Height="17"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="JumpForwardClick" ToolTip="Forward 5 seconds" AutomationProperties.Name="Seek forward">
                  <local:PhosphorIcon Kind="Next" Width="17" Height="17"/>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Click="MuteClick" ToolTip="Mute / unmute (M)" AutomationProperties.Name="Mute or unmute">
                  <local:PhosphorIcon x:Name="VolumeIcon" Kind="Volume" Width="19" Height="19"/>
                </Button>
                <Slider x:Name="VolumeSlider" Width="66" Minimum="0" Maximum="1" Value="0.7" ValueChanged="VolumeChanged" IsMoveToPointEnabled="True" AutomationProperties.Name="Playback volume" Margin="2,0,10,0"/>
                <Button x:Name="FullscreenToggleButton" Style="{StaticResource IconButton}" Click="FullscreenClick" ToolTip="Full screen (F)" AutomationProperties.Name="Full screen">
                  <local:PhosphorIcon x:Name="FullscreenToggleIcon" Kind="Fullscreen" Width="18" Height="18"/>
                </Button>
              </StackPanel>
            </Grid>
            <Grid x:Name="PlaybackActivityPanel" Grid.Row="1" Margin="24,8,24,0"><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Activity" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ApmSummary" Grid.Column="1" Text="APM —" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextAlignment="Right" Margin="8,0" ToolTip="APM rate over a rolling 10-second window"/></Grid><local:PlaybackTimeline x:Name="PlaybackActivity" Grid.Row="1" AutomationProperties.Name="Match activity timeline"/></Grid>
            <Slider x:Name="Seek" Visibility="Collapsed" Minimum="0" Maximum="1" ValueChanged="SeekChanged" PreviewMouseLeftButtonDown="SeekDown" PreviewMouseLeftButtonUp="SeekUp" Grid.Row="1" Margin="24,2,24,0" IsMoveToPointEnabled="True" AutomationProperties.Name="Playback position"/>
          </Grid>
          <Border x:Name="Inspector" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="#30333B" BorderThickness="1,0,0,0" Padding="20,24,20,18" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Clip details" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="Trim range" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,26,0,10"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="14"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="In" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                      <TextBox x:Name="StartInput" Text="00:00.0" LostFocus="RangeInputChanged" FontSize="12" Padding="9,9" AutomationProperties.Name="Trim start"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Out" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                      <TextBox x:Name="EndInput" Text="00:00.0" LostFocus="RangeInputChanged" FontSize="12" Padding="9,9" AutomationProperties.Name="Trim end"/>
                    </StackPanel>
                  </Grid>
                  <Border BorderBrush="#30333B" BorderThickness="0,0,0,1" Margin="0,18,0,0" Padding="0,0,0,19">
                    <StackPanel>
                      <TextBlock Text="Selection duration" Style="{StaticResource Hint}"/>
                      <TextBlock x:Name="RangeLabel" Text="00:00.0" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="MP4 video" FontWeight="SemiBold" Margin="0,20,0,7"/>
                  <TextBlock Text="Export saves a new file. Your original recording stays intact." Style="{StaticResource Hint}"/>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2">
                <TextBlock x:Name="ExportHint" Text="Exports are available after your match." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                <Button x:Name="ExportButton" Style="{StaticResource AccentButton}" Click="ExportClick" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <local:PhosphorIcon Kind="Download" Width="17" Height="17"/>
                    <TextBlock Text="Export clip" FontSize="13" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Border x:Name="TrimWorkbench" Grid.Row="2" Background="#1A1C21" BorderBrush="#353944" BorderThickness="0,1,0,0" Padding="24,13,24,10" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="32"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <local:PhosphorIcon Kind="Scissors" Width="17" Height="17" Foreground="#C2D4FF"/>
                <TextBlock Text="Timeline" FontWeight="SemiBold" FontSize="13" Margin="9,0,18,0"/>
                <TextBlock Text="Drag the edges to trim" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource QuietButton}" Click="SetInClick" Padding="10,4" MinHeight="28" ToolTip="Set start at playhead (I)">
                  <TextBlock Text="Set in" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource QuietButton}" Click="SetOutClick" Padding="10,4" MinHeight="28" ToolTip="Set end at playhead (O)">
                  <TextBlock Text="Set out" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource QuietButton}" Click="ResetTrimClick" Padding="10,4" MinHeight="28" ToolTip="Reset trim">
                  <StackPanel Orientation="Horizontal">
                    <local:PhosphorIcon Kind="Reset" Width="13" Height="13"/>
                    <TextBlock Text="Reset" FontSize="12" Margin="6,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <local:ClipTimeline x:Name="Timeline" Grid.Row="1" AutomationProperties.Name="Video timeline with trim handles and event markers"/>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ActionStatus" Text="Event previews include a 3-second lead-in." Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Space  Play / pause     I / O  Trim" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="SettingsPanel" Grid.Row="2" Grid.Column="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="54"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="#17191D" BorderBrush="#30333B" BorderThickness="0,0,1,0" Padding="22,31">
            <StackPanel>
              <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="5,0,0,25"/>
              <Button x:Name="RecordingCategory" Tag="Recording" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Monitor" Width="18" Height="18"/>
                  <TextBlock Text="Recording" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="AudioCategory" Tag="Audio" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Audio" Width="18" Height="18"/>
                  <TextBlock Text="Audio" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="HighlightsCategory" Tag="Highlights" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Bookmark" Width="18" Height="18"/>
                  <TextBlock Text="Highlights" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="StorageCategory" Tag="Storage" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Storage" Width="18" Height="18"/>
                  <TextBlock Text="Storage" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="InputsCategory" Tag="Inputs" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick"><StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Keyboard" Width="18" Height="18"/><TextBlock Text="Input overlay" FontSize="13" Margin="10,0,0,0"/></StackPanel></Button>
              <Button Content="Run setup" Style="{StaticResource QuietButton}" Click="RunSetupClick" HorizontalAlignment="Left" Margin="14,26,0,0"/>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="880" Margin="38,34,38,30">
              <StackPanel x:Name="RecordingSettings">
                <TextBlock Text="Recording" FontSize="27" FontWeight="Bold"/>
                <Border Style="{StaticResource SettingRow}"><DockPanel><TextBlock Text="Theme" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Width="230" HorizontalAlignment="Right" SelectedIndex="0"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Follow Windows"/></ComboBox></DockPanel></Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,22,0">
                      <TextBlock Text="Recording mode" FontWeight="SemiBold"/>
                      <TextBlock Text="Keep highlights or the whole match." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="ModeBox" AutomationProperties.Name="Recording mode" Grid.Column="1" SelectedIndex="0" VerticalAlignment="Center">
                      <ComboBoxItem Content="Highlights only"/>
                      <ComboBoxItem Content="Entire match"/>
                    </ComboBox>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="Capture source" FontWeight="SemiBold"/>
                        <TextBlock Text="Fullscreen or an isolated window." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                      </StackPanel>
                      <ComboBox x:Name="CaptureMethodBox" AutomationProperties.Name="Capture source" Grid.Column="1" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="Game window"/>
                        <ComboBoxItem Content="Game monitor (fullscreen)"/>
                      </ComboBox>
                    </Grid>
                    <TextBlock Text="Monitor capture includes everything visible on the game's screen while League has focus. The image is masked when you switch apps." Style="{StaticResource Hint}" Margin="0,15,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="143"/>
                      <ColumnDefinition Width="14"/>
                      <ColumnDefinition Width="143"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,22,0">
                      <TextBlock Text="Video quality" FontWeight="SemiBold"/>
                      <TextBlock Text="Choose resolution and frame rate." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="ResolutionBox" AutomationProperties.Name="Recording resolution" Grid.Column="1" SelectedIndex="1" VerticalAlignment="Center">
                      <ComboBoxItem Content="1280 × 720"/>
                      <ComboBoxItem Content="1920 × 1080"/>
                    </ComboBox>
                    <ComboBox x:Name="FpsBox" AutomationProperties.Name="Recording frame rate" Grid.Column="3" SelectedIndex="1" VerticalAlignment="Center">
                      <ComboBoxItem Content="30 FPS"/>
                      <ComboBoxItem Content="60 FPS"/>
                    </ComboBox>
                  </Grid>
                </Border>
              </StackPanel>
              <StackPanel x:Name="AudioSettings" Visibility="Collapsed">
                <TextBlock Text="Audio" FontSize="27" FontWeight="Bold"/>
                <Border Style="{StaticResource SettingRow}">
                  <DockPanel Tag="GameAudioBox" MouseLeftButtonUp="AudioRowClick">
                    <CheckBox x:Name="GameAudioBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Record game audio"/>
                    <StackPanel Margin="0,0,30,0">
                      <TextBlock Text="Game audio" FontWeight="SemiBold"/>
                      <TextBlock Text="Record League sound. Recommended." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <DockPanel Tag="DesktopAudioBox" MouseLeftButtonUp="AudioRowClick">
                    <CheckBox x:Name="DesktopAudioBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="Record all desktop audio"/>
                    <StackPanel Margin="0,0,30,0">
                      <TextBlock Text="All desktop audio" FontWeight="SemiBold"/>
                      <TextBlock Text="Include other apps, music and game audio." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <DockPanel Tag="MicBox" MouseLeftButtonUp="AudioRowClick">
                    <CheckBox x:Name="MicBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="Record microphone"/>
                    <StackPanel Margin="0,0,30,0">
                      <TextBlock Text="Microphone" FontWeight="SemiBold"/>
                      <TextBlock Text="Include your voice in recordings." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <TextBlock Text="Desktop and microphone are off by default. Desktop audio replaces the separate game source to avoid doubling the sound." Style="{StaticResource Hint}" Margin="0,24,0,0"/>
              </StackPanel>
              <StackPanel x:Name="HighlightsSettings" Visibility="Collapsed">
                <Border Style="{StaticResource SettingRow}">
                  <StackPanel>
                    <CheckBox x:Name="RecordInputsBox" Content="Record gameplay inputs"/>
                    <TextBlock Text="APM and keyboard/mouse overlay for future recordings. League controls only, while the game has focus." Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="Highlights" FontSize="27" FontWeight="Bold"/>
                <Border Style="{StaticResource SettingRow}">
                  <StackPanel>
                    <TextBlock Text="Events to capture" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                      <CheckBox x:Name="KillsBox" Content="Kills" IsChecked="True" Margin="0,0,35,0"/>
                      <CheckBox x:Name="AssistsBox" Content="Assists" IsChecked="True" Margin="0,0,35,0"/>
                      <CheckBox x:Name="DeathsBox" Content="Deaths" IsChecked="True"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="120"/>
                      <ColumnDefinition Width="18"/>
                      <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,30,0">
                      <TextBlock Text="Clip length" FontWeight="SemiBold"/>
                      <TextBlock Text="Seconds to keep around an event." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Before" Style="{StaticResource Hint}" Margin="0,0,0,7"/>
                      <TextBox x:Name="BeforeInput" Text="15" AutomationProperties.Name="Seconds before event"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                      <TextBlock Text="After" Style="{StaticResource Hint}" Margin="0,0,0,7"/>
                      <TextBox x:Name="AfterInput" Text="8" AutomationProperties.Name="Seconds after event"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock Text="Clicking an event in the editor starts playback 3 seconds before the action, within the available footage." Style="{StaticResource Hint}" Margin="0,24,0,0"/>
                <Border Style="{StaticResource SettingRow}">
                  <DockPanel>
                    <CheckBox x:Name="RemoveMaskedBox" DockPanel.Dock="Right" IsChecked="True" Style="{StaticResource Switch}" AutomationProperties.Name="Remove Alt Tab gaps from highlights"/>
                    <StackPanel Margin="0,0,24,0">
                      <TextBlock Text="Remove Alt+Tab gaps" FontWeight="SemiBold"/>
                      <TextBlock Text="Highlights only. Full matches stay complete." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <StackPanel>
                    <TextBlock Text="Manual clip shortcut" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,12,0,0">
                      <Button Content="Clear" DockPanel.Dock="Right" Click="ClearShortcutClick" Margin="10,0,0,0"/>
                      <TextBox x:Name="ShortcutInput" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown" Text="Ctrl+Shift+F8" AutomationProperties.Name="Manual clip shortcut" ToolTip="Click and press a shortcut"/>
                    </DockPanel>
                    <TextBlock x:Name="ShortcutMessage" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="StorageSettings" Visibility="Collapsed">
                <TextBlock Text="Storage" FontSize="27" FontWeight="Bold"/>
                <Border Style="{StaticResource SettingRow}">
                  <StackPanel>
                    <TextBlock Text="Recording folder" FontWeight="SemiBold"/>
                    <TextBlock Text="New matches and clips are saved here." Style="{StaticResource Hint}" Margin="0,7,0,17"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseClick" Margin="10,0,0,0"/>
                      <TextBox x:Name="OutputInput" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Recording folder"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="Deleted video files go to the Windows Recycle Bin. Removing a highlight from a full match keeps the shared recording." Style="{StaticResource Hint}" Margin="0,24,0,0"/>
              </StackPanel>
              <StackPanel x:Name="InputSettings" Visibility="Collapsed">
                <TextBlock Text="Input overlay" FontSize="27" FontWeight="Bold"/>
                <Border Style="{StaticResource SettingRow}" Padding="0,14"><StackPanel><StackPanel Orientation="Horizontal"><CheckBox x:Name="InputVisibleBox" Content="Show overlay on clips" IsChecked="True"/><CheckBox x:Name="InputApmBox" Content="Show APM" IsChecked="True" Margin="28,0,0,0"/></StackPanel><TextBlock Text="Enable gameplay input recording in Highlights for keys and APM." Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><DockPanel Margin="0,0,0,9"><Button DockPanel.Dock="Right" Content="Choose keys" Click="CustomizeInputsClick" Padding="8,2" MinHeight="24" Style="{StaticResource QuietButton}"/><TextBlock Text="Layout" VerticalAlignment="Center"/></DockPanel><ComboBox x:Name="InputLayoutBox" SelectedIndex="0"><ComboBoxItem Content="Compact keys + mouse"/><ComboBoxItem Content="Extended keys + mouse"/><ComboBoxItem Content="Mouse"/><ComboBoxItem Content="Custom keys"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Style" Margin="0,0,0,9"/><ComboBox x:Name="InputStyleBox" SelectedIndex="0"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Outline"/></ComboBox></StackPanel></Grid></Border>
                <DockPanel Margin="0,18,0,8"><Button DockPanel.Dock="Right" Content="Use latest clip" Click="RefreshPlacementPreviewClick" Style="{StaticResource QuietButton}" Padding="8,3" MinHeight="28" ToolTip="Use the selected clip, or the latest recording"/><TextBlock Text="Position on screen" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <Border HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><local:OverlayPlacement x:Name="InputPlacementPreview"/></Border>
                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Size"/><Slider x:Name="InputSizeSlider" Minimum="0.15" Maximum="0.85" Value="0.34" ValueChanged="InputSizeChanged" Margin="0,14,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Position" Margin="0,0,0,9"/><ComboBox x:Name="InputPositionBox" SelectedIndex="0" SelectionChanged="InputPositionChanged"><ComboBoxItem Content="Bottom left"/><ComboBoxItem Content="Bottom right"/><ComboBoxItem Content="Top left"/><ComboBoxItem Content="Top right"/><ComboBoxItem Content="Custom"/></ComboBox></StackPanel></Grid></Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="#30333B" BorderThickness="0,1,0,0" Padding="26,14">
          <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SettingsError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SettingsError" Foreground="#FFBFCB" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="Toast" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#30394B" BorderBrush="#65769A" BorderThickness="1" CornerRadius="9" Padding="15,10" Margin="24" Visibility="Collapsed" Panel.ZIndex="30" MaxWidth="460">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="DismissToastClick" AutomationProperties.Name="Dismiss notification" Margin="12,0,0,0">
            <local:PhosphorIcon Kind="Close" Width="15" Height="15"/>
          </Button>
          <TextBlock x:Name="ToastText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
      </Border>
      <Border x:Name="DeleteOverlay" KeyboardNavigation.TabNavigation="Cycle" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#B008090D" Visibility="Collapsed" Panel.ZIndex="20">
        <Border Width="430" Background="#24272E" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
          <StackPanel>
            <local:PhosphorIcon Kind="Delete" Width="27" Height="27" Foreground="#FFBFCB" HorizontalAlignment="Left"/>
            <TextBlock x:Name="DeleteTitle" Text="Delete clip?" FontSize="24" FontWeight="Bold" Margin="0,18,0,12"/>
            <TextBlock x:Name="DeleteDescription" Style="{StaticResource Hint}" FontSize="14" LineHeight="23"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
              <Button x:Name="CancelDeleteButton" Content="Cancel" Click="CancelDeleteClick" Margin="0,0,10,0"/>
              <Button x:Name="ConfirmDeleteButton" Content="Delete clip" Click="ConfirmDeleteClick" Background="#DFA1AD" Foreground="#321822" BorderBrush="#DFA1AD"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
