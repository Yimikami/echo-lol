<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Echo.App.Controls" xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Class="Echo.App.MainWindow" Title="Echo" Width="1480" Height="920" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource StudioFont}" PreviewKeyDown="WindowKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ChampionPortrait" TargetType="Image">
      <Setter Property="Source" Value="{Binding ChampionIcon}"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Stretch" Value="UniformToFill"/>
      <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
      <Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="ShellRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="70"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="TitleBar" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragHeader">
        <Grid Margin="20,0,9,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/echo-emblem.png" Width="25" Height="25"/>
            <TextBlock Text="Echo" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="12,6" VerticalAlignment="Center" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource SecondaryBrush}" Margin="0,0,8,0"/>
              <TextBlock x:Name="HeaderStatus" Text="Connecting to capture" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Click="MinimizeClick" AutomationProperties.Name="Minimize">
              <local:PhosphorIcon Kind="Minimize" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="MaximizeClick" AutomationProperties.Name="Maximize">
              <local:PhosphorIcon Kind="Maximize" Width="14" Height="14"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="CloseClick" ToolTip="Close library; automatic capture keeps running" AutomationProperties.Name="Close library">
              <local:PhosphorIcon Kind="Close" Width="18" Height="18"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock x:Name="ErrorBanner" Grid.Row="1" Grid.ColumnSpan="2" Background="#3D262B" Foreground="#FFC2CC" Padding="20,10" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
              <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Border x:Name="Sidebar" Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,15,0,0">
            <Button x:Name="LibraryNav" Style="{StaticResource RailButton}" Click="LibraryClick" ToolTip="Library" AutomationProperties.Name="Library"><local:PhosphorIcon Kind="Library" Width="22" Height="22"/></Button>
            <Button x:Name="MatchesNav" Style="{StaticResource RailButton}" Click="MatchesClick" ToolTip="Matches" AutomationProperties.Name="Matches"><local:PhosphorIcon Kind="Matches" Width="22" Height="22"/></Button>
            <Button x:Name="FavoritesNav" Style="{StaticResource RailButton}" Click="FavoritesClick" ToolTip="Favorites" AutomationProperties.Name="Favorites"><local:PhosphorIcon Kind="Bookmark" Width="22" Height="22"/></Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,11">
            <Button Style="{StaticResource RailButton}" Click="SaveMomentClick" ToolTip="Save a manual moment" AutomationProperties.Name="Save moment"><local:PhosphorIcon Kind="Clock" Width="19" Height="19"/></Button>
            <Button x:Name="SettingsNav" Style="{StaticResource RailButton}" Click="SettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings"><local:PhosphorIcon Kind="Settings" Width="22" Height="22"/></Button>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="12,9"/>
            <Button x:Name="CaptureButton" Style="{StaticResource RailButton}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" Click="CaptureClick" AutomationProperties.Name="Automatic capture controls">
              <local:PhosphorIcon x:Name="CaptureGlyph" Kind="Recording" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
            </Button>
            <TextBlock x:Name="RecorderLabel" Text="Auto" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0"/>
          </StackPanel>
          <Grid/>
        </DockPanel>
      </Border>
      <Grid x:Name="LibraryPanel" Grid.Row="2" Grid.Column="1" Margin="23,14,19,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="LibraryGutter" Width="0"/><ColumnDefinition x:Name="LibraryAsideColumn" Width="0"/></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2" Grid.ColumnSpan="3" Height="365" VerticalAlignment="Top" Margin="-23,-14,-19,0"
                IsHitTestVisible="False" Opacity=".34" Visibility="{Binding Visibility,ElementName=FeaturedPanel}">
          <Border.Background>
            <ImageBrush ImageSource="{Binding DataContext.HeroArtwork,ElementName=FeaturedPanel}" Stretch="UniformToFill"/>
          </Border.Background>
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint=".5,0" EndPoint=".5,1">
              <GradientStop Color="#23FFFFFF" Offset="0"/>
              <GradientStop Color="#C5FFFFFF" Offset=".26"/>
              <GradientStop Color="#6AFFFFFF" Offset=".61"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </LinearGradientBrush>
          </Border.OpacityMask>
        </Border>
        <Grid x:Name="LibraryHeading" Grid.ColumnSpan="3" Margin="0,0,0,15">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Library" FontSize="31" FontWeight="Bold"/>
            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="9,3" Margin="11,4,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="LibraryCount" Text="0 clips" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <Border Grid.Column="1" Width="260" Margin="14,0,8,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Height="40" VerticalAlignment="Center">
            <DockPanel Margin="11,0">
              <local:PhosphorIcon Kind="Search" Width="17" Height="17" Foreground="{DynamicResource SecondaryBrush}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
              <Grid>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0,9" TextChanged="SearchChanged" AutomationProperties.Name="Search clips"/>
                <TextBlock Text="Search clips" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DockPanel>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SelectModeButton" Content="Select" Click="SelectModeClick" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Height="40" Padding="13,7"/>
            <Button x:Name="LibraryMenuButton" Click="LibraryMenuClick" Height="40" Padding="13,7" AutomationProperties.Name="Library tools">
              <StackPanel Orientation="Horizontal">
                <local:PhosphorIcon Kind="Folder" Width="16" Height="16"/>
                <TextBlock Text="Tools" Margin="7,0,0,0"/>
                <local:PhosphorIcon Kind="ChevronDown" Width="13" Height="13" Margin="6,0,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="LibraryScroll" Grid.Row="1" SizeChanged="LibraryViewportChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
          <StackPanel Margin="0,0,8,0">
            <Grid x:Name="FeaturedPanel" Height="224" Margin="0,2,0,17" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="134"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/><ColumnDefinition Width="192"/>
              </Grid.ColumnDefinitions>
              <Border CornerRadius="10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,8,0,14" Background="{DynamicResource PanelBrush}">
                <Border CornerRadius="9">
                  <Border.Background><ImageBrush ImageSource="{Binding HeroArtwork}" Stretch="UniformToFill"/></Border.Background>
                  <Border CornerRadius="9" VerticalAlignment="Bottom" Padding="9,8" Background="#D20B0D12">
                    <TextBlock Text="{Binding DurationLabel}" FontSize="13" FontWeight="Bold" Foreground="#F8F8FA"/>
                  </Border>
                </Border>
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,7">
                <Border HorizontalAlignment="Left" Background="{DynamicResource NavigationActiveBrush}" Padding="9,4" CornerRadius="5">
                  <TextBlock x:Name="FeaturedLabel" Text="LATEST HIGHLIGHT" Foreground="{DynamicResource NavigationTextBrush}" FontSize="10" FontWeight="Bold"/>
                </Border>
                <DockPanel Margin="0,4,0,0">
                  <Image Style="{StaticResource ChampionPortrait}" Width="33" Height="33" Margin="0,0,10,0"/>
                  <TextBlock x:Name="FeaturedTitle" Text="{Binding Title}" FontSize="40" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="13" Margin="1,2,0,5"/>
                <TextBlock Text="{Binding ShortDate}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" Margin="1,0,0,12"/>
                <Button x:Name="FeaturedPlay" Click="FeaturedClick" HorizontalAlignment="Left" Padding="12,6" MinHeight="37" Style="{StaticResource AccentButton}" AutomationProperties.Name="Play latest recording">
                  <StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Play" Width="16" Height="16"/><TextBlock x:Name="FeaturedPlayLabel" Text="Play clip" FontWeight="Bold" Margin="8,0,0,0"/></StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,7">
                <DockPanel>
                  <local:PhosphorIcon Kind="Clock" Width="15" Height="15" Margin="0,0,7,0" Foreground="{DynamicResource ActivityBrush}"/>
                  <TextBlock Text="Recording events" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}"/>
                </DockPanel>
                <TextBlock Text="{Binding EventCount}" FontSize="35" FontWeight="Bold" Margin="0,0,0,6"/>
                <local:EventStrip Height="7" Points="{Binding EventPoints}" Margin="0,0,0,10"/>
                <UniformGrid Rows="1">
                  <StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Kill" Width="15" Height="15" Foreground="{DynamicResource KillBrush}"/><TextBlock Text="{Binding KillCount}" FontSize="12" Margin="4,0,0,0"/></StackPanel>
                  <StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Assist" Width="15" Height="15" Foreground="{DynamicResource AssistBrush}"/><TextBlock Text="{Binding AssistCount}" FontSize="12" Margin="4,0,0,0"/></StackPanel>
                  <StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Death" Width="15" Height="15" Foreground="{DynamicResource DeathBrush}"/><TextBlock Text="{Binding DeathCount}" FontSize="12" Margin="4,0,0,0"/></StackPanel>
                </UniformGrid>
              </StackPanel>
            </Grid>
            <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox x:Name="LibraryView" Width="120" SelectedIndex="0" SelectionChanged="LibraryViewChanged" Margin="0,0,8,0" AutomationProperties.Name="Library view">
              <ComboBoxItem Content="All items"/>
              <ComboBoxItem Content="Favorites"/>
              <ComboBoxItem Content="Trash"/>
              <ComboBoxItem Content="Missing files"/>
            </ComboBox>
            <ComboBox x:Name="SortBox" Width="136" SelectedIndex="0" SelectionChanged="SortChanged" AutomationProperties.Name="Sort clips">
            <ComboBoxItem Content="Newest first"/>
              <ComboBoxItem Content="Oldest first"/>
            </ComboBox>
          </StackPanel>
              <TextBlock x:Name="GalleryTitle" Text="All clips" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
          <StackPanel x:Name="MomentFilters" Orientation="Horizontal" Margin="0,8,0,12">
            <Button x:Name="FilterAll" Content="All" Tag="All" Click="FilterClick" Padding="14,8" Margin="0,0,8,0"/>
            <Button x:Name="FilterKills" Tag="Kill" Click="FilterClick" Padding="15,8" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <local:PhosphorIcon Kind="Kill" Width="16" Height="16"/>
                <TextBlock Text="Kills" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="FilterAssists" Tag="Assist" Click="FilterClick" Padding="15,8" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <local:PhosphorIcon Kind="Assist" Width="16" Height="16"/>
                <TextBlock Text="Assists" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="FilterDeaths" Tag="Death" Click="FilterClick" Padding="15,8">
              <StackPanel Orientation="Horizontal">
                <local:PhosphorIcon Kind="Death" Width="16" Height="16"/>
                <TextBlock Text="Deaths" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="MoreEventsButton" Content="Events" Click="MoreEventsClick" Padding="10,8" Margin="8,0,0,0"/>
          </StackPanel>
        <Grid x:Name="ClipBrowser">
          <ListBox x:Name="ClipList" PreviewMouseLeftButtonDown="GalleryMouseDown" SelectionChanged="ClipSelected" SizeChanged="GalleryWidthChanged" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Clip gallery">
            <ListBox.Resources>
              <sys:Double x:Key="GalleryTileWidth">300</sys:Double>
              <sys:Double x:Key="GalleryThumbnailHeight">168</sys:Double>
            </ListBox.Resources>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Width" Value="{DynamicResource GalleryTileWidth}"/>
                <Setter Property="Margin" Value="0,0,14,14"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Card" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="0,0,0,11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Card" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                          <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                <StackPanel x:Name="HighlightTile">
                  <Grid Height="{DynamicResource GalleryThumbnailHeight}">
                    <Border Background="{DynamicResource RaisedBrush}" CornerRadius="7,7,0,0">
                      <local:PhosphorIcon Kind="Matches" Width="32" Height="32" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="7,7,0,0">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                      </Border.Background>
                    </Border>
                    <Border Width="42" Height="42" CornerRadius="21" Background="#D91A211C" BorderBrush="#91C5F65B" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                <Condition Binding="{Binding IsReady}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <local:PhosphorIcon Kind="Play" Width="17" Height="17" Foreground="#C5F65B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#E20B0D11" CornerRadius="4" Padding="7,4" Margin="9">
                      <TextBlock Text="{Binding DurationLabel}" FontSize="12" Foreground="White"/>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E20B0D11" CornerRadius="4" Padding="6" Margin="9" Visibility="{Binding FavoriteVisibility}">
                      <local:PhosphorIcon Kind="Bookmark" Width="15" Height="15" Foreground="#E2C3FF"/>
                    </Border>
                    <Border Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9" Padding="6" CornerRadius="4">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <local:PhosphorIcon Kind="Check" Width="15" Height="15" Foreground="{DynamicResource AccentTextBrush}"/>
                    </Border>
                    <Border Background="#E3232B38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Padding="7,4" CornerRadius="4" Visibility="{Binding StateVisibility}">
                      <TextBlock Text="{Binding StateLabel}" FontSize="12" Foreground="#F6F8FC"/>
                    </Border>
                  </Grid>
                  <Grid Margin="11,9,11,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                      <Image Style="{StaticResource ChampionPortrait}"/>
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Visibility="{Binding KillVisibility}" Margin="9,0,0,0">
                        <local:PhosphorIcon Kind="Kill" Width="15" Height="15" Foreground="{DynamicResource KillBrush}"/>
                        <TextBlock Text="{Binding KillCount}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="{DynamicResource KillBrush}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding DeathVisibility}" Margin="9,0,0,0">
                        <local:PhosphorIcon Kind="Death" Width="15" Height="15" Foreground="{DynamicResource DeathBrush}"/>
                        <TextBlock Text="{Binding DeathCount}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="{DynamicResource DeathBrush}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding AssistVisibility}" Margin="9,0,0,0">
                        <local:PhosphorIcon Kind="Assist" Width="15" Height="15" Foreground="{DynamicResource AssistBrush}"/>
                        <TextBlock Text="{Binding AssistCount}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="{DynamicResource AssistBrush}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding ManualVisibility}" Margin="9,0,0,0">
                        <local:PhosphorIcon Kind="Bookmark" Width="15" Height="15" Foreground="{DynamicResource SecondaryBrush}"/>
                        <TextBlock Text="{Binding ManualCount}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="{DynamicResource SecondaryBrush}"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="11,3,11,0"/>
                  <local:EventStrip Height="6" Margin="11,9,11,0" Points="{Binding EventPoints}"/>
                  <TextBlock Text="{Binding ShortDate}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" Margin="11,6,11,0"/>
                </StackPanel>
                <Grid x:Name="MatchTile" Visibility="Collapsed" Margin="11,11,11,1" MinHeight="104">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="102"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border CornerRadius="8" Background="{DynamicResource RaisedBrush}">
                    <Border CornerRadius="8">
                      <Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background>
                      <Border VerticalAlignment="Bottom" Background="#D4080C12" Padding="7,3" CornerRadius="0,0,8,8">
                        <TextBlock Text="{Binding DurationLabel}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                      </Border>
                    </Border>
                  </Border>
                  <StackPanel Grid.Column="2">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding StateLabel}" Visibility="{Binding StateVisibility}" Foreground="{DynamicResource ActivityBrush}" FontSize="10" Margin="5,0,0,0"/>
                      <Image Style="{StaticResource ChampionPortrait}"/>
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ShortDate}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" Margin="0,4,0,8"/>
                    <UniformGrid Rows="1">
                      <StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Kill" Width="14" Height="14" Foreground="{DynamicResource KillBrush}"/><TextBlock Text="{Binding KillCount}" FontSize="11" Margin="4,0,0,0"/></StackPanel>
                      <StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Assist" Width="14" Height="14" Foreground="{DynamicResource AssistBrush}"/><TextBlock Text="{Binding AssistCount}" FontSize="11" Margin="4,0,0,0"/></StackPanel>
                      <StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Death" Width="14" Height="14" Foreground="{DynamicResource DeathBrush}"/><TextBlock Text="{Binding DeathCount}" FontSize="11" Margin="4,0,0,0"/></StackPanel>
                    </UniformGrid>
                    <local:EventStrip Height="6" Margin="0,9,0,0" Points="{Binding EventPoints}"/>
                  </StackPanel>
                </Grid>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding WholeMatch}" Value="True">
                    <Setter TargetName="HighlightTile" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="MatchTile" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyGallery" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" MinHeight="230" IsHitTestVisible="False">
            <local:PhosphorIcon Kind="Matches" Width="50" Height="50" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyTitle" Text="No clips yet" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,24,0,10"/>
            <TextBlock x:Name="EmptyList" Text="Keep Echo running and play League. Your kills, assists and deaths will appear here automatically." Style="{StaticResource Hint}" TextAlignment="Center"/>
          </StackPanel>
        </Grid>
          </StackPanel>
        </ScrollViewer>
        <Border x:Name="LibraryAside" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Visibility="Collapsed">
