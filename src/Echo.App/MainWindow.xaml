          <local:PhosphorIcon x:Name="ToastIcon" Kind="Info" Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" Foreground="{DynamicResource AssistBrush}"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="ToastTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource SecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel x:Name="ToastActions" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="ToastActionButton" Click="ToastActionClick" FontSize="12" Padding="12,7" MinHeight="32" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" Margin="0,0,8,0"/>
              <Button x:Name="ToastDetailsButton" Content="Details" Click="ToastDetailsClick" FontSize="12" Padding="10,7" MinHeight="32" Background="Transparent"/>
            </StackPanel>
            <StackPanel x:Name="ToastDetailsPanel" Visibility="Collapsed" Margin="0,12,0,0">
              <TextBox x:Name="ToastDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" FontSize="12" Padding="10" Background="{DynamicResource PanelBrush}" AutomationProperties.Name="Error details"/>
              <Button x:Name="ToastCopyButton" Content="Copy details" Click="ToastCopyClick" HorizontalAlignment="Left" FontSize="12" Padding="10,6" MinHeight="30" Margin="0,8,0,0" Background="Transparent"/>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" VerticalAlignment="Top" Click="DismissToastClick" AutomationProperties.Name="Dismiss notification" ToolTip="Dismiss" Margin="5,-5,-5,0"><local:PhosphorIcon Kind="Close" Width="14" Height="14"/></Button>
        </Grid>
      </Border>
      </StackPanel>
      <Border x:Name="DeleteOverlay" KeyboardNavigation.TabNavigation="Cycle" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#B008090D" Visibility="Collapsed" Panel.ZIndex="20">
        <Border Width="430" Background="{DynamicResource PanelBrush}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
          <StackPanel>
            <local:PhosphorIcon Kind="Delete" Width="27" Height="27" Foreground="#FFBFCB" HorizontalAlignment="Left"/>
            <TextBlock x:Name="DeleteTitle" Text="Delete clip?" FontSize="24" FontWeight="Bold" Margin="0,18,0,12"/>
            <TextBlock x:Name="DeleteDescription" Style="{StaticResource Hint}" FontSize="14" LineHeight="23"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
              <Button x:Name="CancelDeleteButton" Content="Cancel" Click="CancelDeleteClick" Margin="0,0,10,0"/>
              <Button x:Name="ConfirmDeleteButton" Content="Delete clip" Click="ConfirmDeleteClick" Background="#DFA1AD" Foreground="#321822" BorderBrush="#DFA1AD"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
