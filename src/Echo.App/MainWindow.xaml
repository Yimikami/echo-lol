                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="RecentCaptureClick" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="4,6" Margin="0,2,0,0"
                              AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Subtitle}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="53"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="49" Height="33" CornerRadius="5" HorizontalAlignment="Left" Background="{DynamicResource RaisedBrush}">
                            <Border CornerRadius="5"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background></Border>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,6,0">
                            <DockPanel>
                              <Image Style="{StaticResource ChampionPortrait}" Width="15" Height="15" Margin="0,0,4,0"/>
                              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Bold"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,0,0"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" FontSize="10"/>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,6,0" MinHeight="42">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="SelectionToolbar" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="This page" Click="SelectPageClick" Margin="0,0,6,0"/>
            <Button Content="All results" Click="SelectResultsClick" Margin="0,0,6,0"/>
            <Button Content="Clear" Click="ClearSelectionClick" Margin="0,0,6,0"/>
            <Button x:Name="SelectionActions" Content="Actions" Click="SelectionActionsClick" Style="{StaticResource AccentButton}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock x:Name="PageLabel" Text="Page 1 of 1" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="PreviousPageButton" Style="{StaticResource IconButton}" Click="PreviousPageClick" ToolTip="Previous page" AutomationProperties.Name="Previous page">
              <local:PhosphorIcon Kind="Previous" Width="17" Height="17"/>
            </Button>
            <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" Click="NextPageClick" ToolTip="Next page" AutomationProperties.Name="Next page">
              <local:PhosphorIcon Kind="Next" Width="17" Height="17"/>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
      <Grid x:Name="EditorPanel" Grid.Row="2" Grid.Column="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="70"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <Border x:Name="SelectedHeading" Background="{DynamicResource BackgroundBrush}" Padding="17,0,20,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="BackToLibraryClick" VerticalAlignment="Center" ToolTip="Back to library (Esc)" AutomationProperties.Name="Back to library">
              <local:PhosphorIcon Kind="Back"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
              <DockPanel>
                <Image Style="{StaticResource ChampionPortrait}" Source="{Binding DataContext.ChampionIcon, ElementName=ReviewDesk}" Width="25" Height="25"/>
                <TextBlock x:Name="SelectedTitle" Text="Clip" FontSize="27" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <TextBlock x:Name="SelectedDetails" Text="Select a recording" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="QuickInputsButton" Style="{StaticResource QuietButton}" Click="TogglePlaybackInputs" ToolTip="Show or hide keyboard and mouse"><local:PhosphorIcon Kind="Keyboard" Width="20" Height="20"/></Button>
              <Button x:Name="RecapButton" Content="Recap" Style="{StaticResource QuietButton}" Click="RecapClick" Visibility="Collapsed" Margin="0,0,8,0"/>
              <Button x:Name="ReviewMenuButton" Content="More" Style="{StaticResource QuietButton}" Click="ReviewMenuClick" Margin="0,0,8,0"/>
              <Button x:Name="QuickExportButton" Style="{StaticResource AccentButton}" Click="ExportClick" Margin="0,0,10,0" AutomationProperties.Name="Export video">
                <StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Download" Width="17" Height="17"/><TextBlock Text="Export" Margin="7,0,0,0" FontWeight="Bold"/></StackPanel>
              </Button>
              <Button x:Name="EditTrimButton" Style="{StaticResource QuietButton}" Click="ToggleTrimClick" Margin="0,0,12,0" AutomationProperties.Name="Toggle trimming">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Scissors" Width="18" Height="18"/>
                  <TextBlock x:Name="TrimButtonLabel" Text="Trim" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="RevealButton" Style="{StaticResource IconButton}" Click="RevealClick" ToolTip="Show in folder" AutomationProperties.Name="Show in folder">
                <local:PhosphorIcon Kind="Folder" Width="19" Height="19"/>
              </Button>
              <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Click="DeleteClick" ToolTip="Delete clip" AutomationProperties.Name="Delete clip">
                <local:PhosphorIcon Kind="Delete" Width="19" Height="19"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="Editor" Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="InspectorColumn" Width="0"/>
            <ColumnDefinition x:Name="ReviewColumn" Width="0"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="PlayerDock">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="148"/>
              <RowDefinition Height="58"/>
            </Grid.RowDefinitions>
            <Border x:Name="VideoSurface" Background="#080A09" Margin="19,0,9,0" CornerRadius="13" ClipToBounds="True" MouseLeftButtonDown="VideoClicked">
              <Grid>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaOpened="MediaOpened" MediaEnded="MediaEnded" MediaFailed="MediaFailed"/>
                <Image x:Name="PlayerPoster" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Canvas x:Name="InputCanvas" ClipToBounds="True" SizeChanged="InputCanvasResized" MouseMove="InputCanvasHover" MouseLeave="InputCanvasLeave">
                  <local:InputOverlay x:Name="PlaybackInputs" Cursor="SizeAll" MouseLeftButtonDown="InputLayerDown" MouseMove="InputLayerMove" MouseLeftButtonUp="InputLayerUp" Visibility="Collapsed"/>
                  <Border x:Name="InputLayerOutline" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False" Visibility="Collapsed"/>
                  <Button x:Name="InputCollapseButton" Width="24" Height="22" MinHeight="20" Padding="0" Content="−" Click="CollapsePlaybackInputs" ToolTip="Collapse or expand overlay" Visibility="Collapsed"/>
                  <Thumb x:Name="InputResizeGrip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="14" Height="14" Cursor="SizeNWSE" DragStarted="InputResizeStarted" DragDelta="InputResizeDelta" DragCompleted="InputResizeCompleted" Visibility="Collapsed"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="2" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb>
                </Canvas>
                <StackPanel x:Name="EmptyPlayer" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <local:PhosphorIcon Kind="Play" Width="40" Height="40" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Choose a clip to preview" FontSize="18" Margin="0,20,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="19,0,9,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Click="JumpBackClick" ToolTip="Back 5 seconds" AutomationProperties.Name="Seek backward">
                  <local:PhosphorIcon Kind="Previous" Width="17" Height="17"/>
                </Button>
                <Button x:Name="PlayButton" Width="42" Height="38" Padding="10,8" Style="{StaticResource AccentButton}" Click="PlayClick" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause">
                  <local:PhosphorIcon x:Name="PlayIcon" Kind="Play" Width="17" Height="17"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="JumpForwardClick" ToolTip="Forward 5 seconds" AutomationProperties.Name="Seek forward">
                  <local:PhosphorIcon Kind="Next" Width="17" Height="17"/>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Click="MuteClick" ToolTip="Mute / unmute (M)" AutomationProperties.Name="Mute or unmute">
                  <local:PhosphorIcon x:Name="VolumeIcon" Kind="Volume" Width="19" Height="19"/>
                </Button>
                <Slider x:Name="VolumeSlider" Width="66" Minimum="0" Maximum="1" Value="0.7" ValueChanged="VolumeChanged" IsMoveToPointEnabled="True" AutomationProperties.Name="Playback volume" Margin="2,0,10,0"/>
                <Button x:Name="FullscreenToggleButton" Style="{StaticResource IconButton}" Click="FullscreenClick" ToolTip="Full screen (F)" AutomationProperties.Name="Full screen">
                  <local:PhosphorIcon x:Name="FullscreenToggleIcon" Kind="Fullscreen" Width="18" Height="18"/>
                </Button>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9"
                    Margin="19,10,9,0" Visibility="{Binding Visibility,ElementName=PlaybackActivityPanel}">
              <Grid x:Name="PlaybackActivityPanel" Margin="11,7,11,4">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                  <TextBlock x:Name="ApmSummary" DockPanel.Dock="Right" Text="APM —" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="12,0,2,0" ToolTip="APM rate over a rolling 10-second window"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <local:PhosphorIcon Kind="Kill" Width="12" Height="12" Foreground="{DynamicResource KillBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="Kill" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,9,0"/>
                    <local:PhosphorIcon Kind="Assist" Width="12" Height="12" Foreground="{DynamicResource AssistBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="Assist" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,9,0"/>
                    <local:PhosphorIcon Kind="Death" Width="12" Height="12" Foreground="{DynamicResource DeathBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="Death" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"/>
                  </StackPanel>
                  <TextBlock Text="Activity timeline" FontSize="12" FontWeight="Bold"/>
                </DockPanel>
                <local:PlaybackTimeline x:Name="PlaybackActivity" Grid.Row="1" AutomationProperties.Name="Match activity timeline"/>
              </Grid>
            </Border>
            <Slider x:Name="Seek" Visibility="Collapsed" Minimum="0" Maximum="1" ValueChanged="SeekChanged" PreviewMouseLeftButtonDown="SeekDown" PreviewMouseLeftButtonUp="SeekUp" Grid.Row="1" Margin="24,2,24,0" IsMoveToPointEnabled="True" AutomationProperties.Name="Playback position"/>
          </Grid>
          <Border x:Name="ReviewDesk" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Margin="6,0,19,10" Padding="14,15,13,10" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,13">
                <local:PhosphorIcon Kind="Clock" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="Event index" FontSize="16" FontWeight="Bold"/>
              </DockPanel>
              <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,12">
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="7,6" Margin="0,0,4,0">
                  <StackPanel><TextBlock Text="{Binding KillCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/><TextBlock Text="Kills" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="7" Padding="7,6" Margin="0,0,4,0">
                  <StackPanel><TextBlock Text="{Binding AssistCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AssistBrush}"/><TextBlock Text="Assists" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="7" Padding="7,6">
                  <StackPanel><TextBlock Text="{Binding DeathCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DeathBrush}"/><TextBlock Text="Deaths" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel>
                </Border>
              </UniformGrid>
              <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="ReviewEvents">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Click="ReviewEventClick" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="7,6" Margin="0,0,0,3"
                                AutomationProperties.Name="{Binding Label}" ToolTip="Play from before this event">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <local:PhosphorIcon Kind="{Binding Icon}" Foreground="{Binding Color}" Width="16" Height="16" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Stamp}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyReviewEvents" Text="No events in this recording." Style="{StaticResource Hint}" Margin="5,10,5,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
              </Grid>
            </Grid>
          </Border>
          <Border x:Name="Inspector" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,24,20,18" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Clip details" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="Trim range" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,26,0,10"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="14"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="In" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                      <TextBox x:Name="StartInput" Text="00:00.0" LostFocus="RangeInputChanged" FontSize="12" Padding="9,9" AutomationProperties.Name="Trim start"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Out" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                      <TextBox x:Name="EndInput" Text="00:00.0" LostFocus="RangeInputChanged" FontSize="12" Padding="9,9" AutomationProperties.Name="Trim end"/>
                    </StackPanel>
                  </Grid>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,0" Padding="0,0,0,19">
                    <StackPanel>
                      <TextBlock Text="Selection duration" Style="{StaticResource Hint}"/>
                      <TextBlock x:Name="RangeLabel" Text="00:00.0" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="MP4 video" FontWeight="SemiBold" Margin="0,20,0,7"/>
                  <TextBlock Text="Export saves a new file. Your original recording stays intact." Style="{StaticResource Hint}"/>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2">
                <TextBlock x:Name="ExportHint" Text="Exports are available after your match." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                <Button x:Name="ExportButton" Style="{StaticResource AccentButton}" Click="ExportClick" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <local:PhosphorIcon Kind="Download" Width="17" Height="17"/>
                    <TextBlock Text="Export clip" FontSize="13" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Border x:Name="TrimWorkbench" Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,13,24,10" Visibility="Collapsed">
