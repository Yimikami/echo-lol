                  <Border Background="{DynamicResource RaisedBrush}" CornerRadius="7" Padding="9,7" Margin="4,0,0,0">
                    <StackPanel><TextBlock x:Name="OverviewFavorites" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource FavoriteBrush}"/><TextBlock Text="Favorites" Style="{StaticResource Hint}"/></StackPanel>
