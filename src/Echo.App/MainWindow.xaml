              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <local:PhosphorIcon Kind="Scissors" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Timeline" FontWeight="SemiBold" FontSize="13" Margin="9,0,18,0"/>
                <TextBlock Text="Drag the edges to trim" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource QuietButton}" Click="SetInClick" Padding="10,4" MinHeight="28" ToolTip="Set start at playhead (I)">
                  <TextBlock Text="Set in" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource QuietButton}" Click="SetOutClick" Padding="10,4" MinHeight="28" ToolTip="Set end at playhead (O)">
                  <TextBlock Text="Set out" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource QuietButton}" Click="ResetTrimClick" Padding="10,4" MinHeight="28" ToolTip="Reset trim">
                  <StackPanel Orientation="Horizontal">
                    <local:PhosphorIcon Kind="Reset" Width="13" Height="13"/>
                    <TextBlock Text="Reset" FontSize="12" Margin="6,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <local:ClipTimeline x:Name="Timeline" Grid.Row="1" AutomationProperties.Name="Video timeline with trim handles and event markers"/>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ActionStatus" Text="Event previews include a 3-second lead-in." Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Space  Play / pause     I / O  Trim" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="SettingsPanel" Grid.Row="2" Grid.Column="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="163"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="11,18,10,12">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Run setup" Click="RunSetupClick" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="9,8"/>
              <StackPanel>
                <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Margin="8,1,0,18"/>
              <Button x:Name="RecordingCategory" Tag="Recording" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick" Padding="9,9">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Monitor" Width="18" Height="18"/>
                  <TextBlock Text="Recording" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="AudioCategory" Tag="Audio" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick" Padding="9,9">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Audio" Width="18" Height="18"/>
                  <TextBlock Text="Audio" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="HighlightsCategory" Tag="Highlights" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick" Padding="9,9">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Bookmark" Width="18" Height="18"/>
                  <TextBlock Text="Highlights" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="StorageCategory" Tag="Storage" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick" Padding="9,9">
                <StackPanel Orientation="Horizontal">
                  <local:PhosphorIcon Kind="Storage" Width="18" Height="18"/>
                  <TextBlock Text="Storage" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="InputsCategory" Tag="Inputs" Style="{StaticResource CategoryButton}" Click="SettingsCategoryClick" Padding="9,9"><StackPanel Orientation="Horizontal"><local:PhosphorIcon Kind="Keyboard" Width="18" Height="18"/><TextBlock Text="Input overlay" FontSize="13" Margin="10,0,0,0"/></StackPanel></Button>
