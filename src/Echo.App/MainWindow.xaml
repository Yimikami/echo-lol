              </StackPanel>
            </Border>
            <Border x:Name="RecentPanel" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="12" Margin="0,13,0,0">
