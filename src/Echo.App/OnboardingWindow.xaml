<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Echo.App.Controls" x:Class="Echo.App.OnboardingWindow" Title="Welcome to Echo" Width="960" Height="760" MinWidth="900" MinHeight="700" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource StudioFont}" PreviewKeyDown="SetupKeyDown">
  <Window.Resources>
    <Style x:Key="SetupCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
    <Style x:Key="SetupModeCard" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="132"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="2" CornerRadius="16" Padding="16,12">
              <Grid>
                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Border x:Name="SelectedBadge" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                  <local:PhosphorIcon Kind="Check" Width="15" Height="15" Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource RaisedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" x:Name="SetupArtworkColumn"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource SidebarBrush}" ClipToBounds="True" x:Name="SetupArtwork">
        <Grid>
          <Border IsHitTestVisible="False">
            <Border.Background><ImageBrush ImageSource="pack://application:,,,/Echo;component/Assets/setup-jinx.jpg" Stretch="UniformToFill" AlignmentX="Center"/></Border.Background>
          </Border>
          <Border IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F008090A" Offset="0"/><GradientStop Color="#D908090A" Offset=".58"/><GradientStop Color="#3008090A" Offset="1"/></LinearGradientBrush></Border.Background>
          </Border>
          <StackPanel Margin="31,29,29,0" TextElement.Foreground="#F4F7F8">
            <StackPanel.Resources>
              <SolidColorBrush x:Key="TextBrush" Color="#F4F7F8"/>
              <SolidColorBrush x:Key="SecondaryBrush" Color="#B8C1C8"/>
              <SolidColorBrush x:Key="AccentBrush" Color="#C5F65B"/>
              <SolidColorBrush x:Key="AccentTextBrush" Color="#172305"/>
              <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#232D17"/>
              <SolidColorBrush x:Key="SidebarBrush" Color="#08090A"/>
              <SolidColorBrush x:Key="LineBrush" Color="#41484E"/>
            </StackPanel.Resources>
            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="SetupDrag">
              <Border Background="{DynamicResource AccentBrush}" CornerRadius="12" Width="40" Height="40">
                <local:PhosphorIcon Kind="Play" Width="18" Height="18" Foreground="{DynamicResource AccentTextBrush}"/>
              </Border>
              <TextBlock Text="Echo" Style="{StaticResource DisplayHeading}" FontSize="34" VerticalAlignment="Center" Margin="12,1,0,0"/>
            </StackPanel>
            <TextBlock Text="Quick setup" Style="{StaticResource DisplayHeading}" FontSize="41" Margin="0,28,0,0"/>
            <TextBlock x:Name="StepNumber" Text="Step 1 of 5" FontSize="13" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0"/>
            <ProgressBar x:Name="Progress" Maximum="5" Value="1" Height="3" Margin="0,11,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}"/>
            <StackPanel x:Name="SetupSteps" Margin="0,19,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}" Margin="35,29,46,28" x:Name="SetupContent">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid MouseLeftButtonDown="SetupDrag">
          <StackPanel Margin="0,0,20,0">
            <TextBlock x:Name="StepTitle" Text="Appearance" Style="{StaticResource DisplayHeading}" FontSize="59"/>
            <TextBlock x:Name="StepDescription" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Left" MaxWidth="440" Margin="0,5,0,0" FontSize="15"/>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="SetupScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,10">
          <Grid>
            <StackPanel x:Name="AppearanceStep">
              <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                  <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,10"/>
                  <ListBox x:Name="ThemeChoice" Style="{StaticResource SegmentedChoice}" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="Theme">
                    <ListBoxItem Content="Dark"/>
                    <ListBoxItem Content="Light"/>
                    <ListBoxItem Content="Follow Windows"/>
                  </ListBox>
                  <Grid Height="100" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource RaisedBrush}" CornerRadius="6,0,0,6"/><Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="0,6,6,0" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="12"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions><Border Background="{DynamicResource AccentBrush}" Width="78" HorizontalAlignment="Left" CornerRadius="3"/><UniformGrid Grid.Row="2" Columns="3"><Border Background="{DynamicResource RaisedBrush}" CornerRadius="5" Margin="0,0,8,0"/><Border Background="{DynamicResource RaisedBrush}" CornerRadius="5" Margin="0,0,8,0"/><Border Background="{DynamicResource RaisedBrush}" CornerRadius="5"/></UniformGrid></Grid></Border></Grid>
                  <TextBlock Text="Pick your preferred look. System follows your Windows theme." Style="{StaticResource Hint}" Margin="0,18,0,0"/></StackPanel>
              </Border>
            </StackPanel>
            <StackPanel x:Name="CaptureStep" Visibility="Collapsed">
              <Border Style="{StaticResource SetupCard}" Margin="0,0,0,14" Padding="18,12"><StackPanel>
<DockPanel><Button x:Name="UseSuggestedQuality" Content="Use suggested" Click="UseSuggestedQualityClick" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" IsEnabled="False" FontSize="12" Padding="8,5"/><TextBlock Text="Video quality" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<TextBlock x:Name="SetupQualitySuggestion" Text="Finding a starting preset for your PC…" Style="{StaticResource Hint}" Margin="0,7,0,12"/>
<ListBox x:Name="QualityChoice" Style="{StaticResource SegmentedChoice}" SelectedIndex="3" AutomationProperties.Name="Video quality" SelectionChanged="QualityChanged">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem Content="720p · 30 FPS" Padding="10,9"/>
                    <ListBoxItem Content="720p · 60 FPS" Padding="10,9"/>
                    <ListBoxItem Content="1080p · 30 FPS" Padding="10,9"/>
                    <ListBoxItem Content="1080p · 60 FPS" Padding="10,9"/>
                  </ListBox>
                <TextBlock x:Name="SetupHardware" Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel></Border><ListBox x:Name="ModeChoice" Style="{StaticResource SegmentedChoice}" Background="Transparent" ItemContainerStyle="{StaticResource SetupModeCard}" SelectedIndex="0" AutomationProperties.Name="Recording mode">
                <ListBoxItem Margin="0,0,7,0" AutomationProperties.Name="Highlights only">
                  <StackPanel>
                    <local:PhosphorIcon Kind="Recording" Foreground="{DynamicResource AccentBrush}" Width="25" Height="25" HorizontalAlignment="Left"/>
                    <TextBlock Text="Highlights only" Style="{StaticResource DisplayHeading}" FontSize="31" Margin="0,9,0,3"/>
                    <TextBlock Text="Keep clips around the events you choose." Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Margin="7,0,0,0" AutomationProperties.Name="Entire match">
                  <StackPanel>
                    <local:PhosphorIcon Kind="Matches" Foreground="{DynamicResource SecondaryBrush}" Width="25" Height="25" HorizontalAlignment="Left"/>
                    <TextBlock Text="Entire match" Style="{StaticResource DisplayHeading}" FontSize="31" Margin="0,9,0,3"/>
                    <TextBlock Text="Keep the full match, with event markers." Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </ListBoxItem>
              </ListBox>
              <TextBlock Text="Capture source" FontWeight="Bold" Margin="0,12,0,7"/>
              <ListBox x:Name="SourceChoice" Style="{StaticResource SegmentedChoice}" Background="{DynamicResource PanelBrush}" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Capture source">
                <ListBoxItem Content="Game window"/>
                <ListBoxItem Content="Game monitor · fullscreen"/>
              </ListBox>
              <TextBlock Text="Use Game monitor for exclusive fullscreen. Other apps are masked when you switch away." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel x:Name="HighlightsStep" Visibility="Collapsed">
              <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                  <TextBlock Text="Events to capture" FontWeight="SemiBold" Margin="0,0,0,16"/>
                  <WrapPanel x:Name="SetupEvents">
                    <CheckBox Style="{StaticResource EventChip}" x:Name="KillsChoice" Content="Kills" IsChecked="True" Margin="0,0,8,8" Tag="Kill"/>
                    <CheckBox Style="{StaticResource EventChip}" x:Name="AssistsChoice" Content="Assists" IsChecked="True" Margin="0,0,8,8" Tag="Assist"/>
                    <CheckBox Style="{StaticResource EventChip}" x:Name="DeathsChoice" Content="Deaths" IsChecked="True" Tag="Death" Margin="0,0,8,8"/>
                  <CheckBox Tag="MultiKill" Content="Multikills" Style="{StaticResource EventChip}" Margin="0,0,8,8"/><CheckBox Tag="Ace" Content="Aces" Style="{StaticResource EventChip}" Margin="0,0,8,8"/><CheckBox Tag="Baron" Content="Baron" Style="{StaticResource EventChip}" Margin="0,0,8,8"/><CheckBox Tag="Dragon" Content="Dragons" Style="{StaticResource EventChip}" Margin="0,0,8,8"/><CheckBox Tag="Herald" Content="Rift Herald" Style="{StaticResource EventChip}" Margin="0,0,8,8"/><CheckBox Tag="Turret" Content="Turrets" Style="{StaticResource EventChip}" Margin="0,0,8,8"/><CheckBox Tag="Inhibitor" Content="Inhibitors" Style="{StaticResource EventChip}" Margin="0,0,8,8"/></WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
<TextBlock Text="Before" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="BeforeChoice" Text="15" Style="{StaticResource DurationInput}" AutomationProperties.Name="Seconds before event"/><TextBlock Text="s" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,24,0"/>
<TextBlock Text="After" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="AfterChoice" Text="8" Style="{StaticResource DurationInput}" AutomationProperties.Name="Seconds after event"/><TextBlock Text="s" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
</StackPanel><TextBlock Text="Manual clip shortcut" FontWeight="SemiBold" Margin="0,26,0,10"/>
                  <TextBox x:Name="ShortcutChoice" Text="Ctrl+Shift+F8" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown" ToolTip="Click and press a shortcut. Backspace clears it."/>
                  <DockPanel Margin="0,24,0,0"><CheckBox x:Name="InputsChoice" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Record APM and gameplay inputs"/><TextBlock Text="APM &amp; input overlay" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Enables APM activity and input overlays in new recordings." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel x:Name="AudioStep" Visibility="Collapsed"><Border Style="{StaticResource SetupCard}" Margin="0,0,0,12"><DockPanel><CheckBox x:Name="GameChoice" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="Game audio"/><StackPanel Margin="0,0,20,0"><TextBlock Text="Game audio" FontWeight="SemiBold"/><TextBlock Text="League sound only." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border><Border Style="{StaticResource SetupCard}" Margin="0,0,0,12"><DockPanel><CheckBox x:Name="DesktopChoice" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="Desktop audio"/><StackPanel Margin="0,0,20,0"><TextBlock Text="Desktop audio" FontWeight="SemiBold"/><TextBlock Text="Game sound, music and other apps." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border><Border Style="{StaticResource SetupCard}" Margin="0,0,0,12"><DockPanel><CheckBox x:Name="MicChoice" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="Microphone"/><StackPanel Margin="0,0,20,0"><TextBlock Text="Microphone" FontWeight="SemiBold"/><TextBlock Text="Include your voice." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border><Border Style="{StaticResource SetupCard}" Margin="0,0,0,12"><DockPanel><CheckBox x:Name="TracksChoice" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="Separate audio tracks"/><StackPanel Margin="0,0,20,0"><TextBlock Text="Separate audio tracks" FontWeight="SemiBold"/><TextBlock Text="Keep sources separate for later export." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border><TextBlock Text="Desktop audio already includes game sound." Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="StorageStep" Visibility="Collapsed">
              <Border Style="{StaticResource SetupCard}">
                <StackPanel>
                  <TextBlock Text="Save recordings to" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <TextBox x:Name="FolderChoice" TextWrapping="Wrap"/>
                  <Button Content="Choose folder" Click="BrowseFolder" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                  <TextBlock Text="Your setup" FontWeight="SemiBold" Margin="0,32,0,0"/>
                  <TextBlock x:Name="SetupSummary" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                  <TextBlock Text="Echo starts recording when you enter a League match. You can change these choices in Settings." Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,17,0,0">
          <StackPanel>
            <TextBlock x:Name="SetupError" Foreground="{DynamicResource DeathBrush}" TextWrapping="Wrap" Margin="0,0,0,10">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <DockPanel>
            <Button Content="Skip for now" Click="SkipClick" Style="{StaticResource QuietButton}" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BackButton" Content="Back" Click="BackClick" Background="Transparent" MinWidth="80" Height="44" Margin="0,0,10,0" Visibility="Collapsed"/>
              <Button x:Name="NextButton" Content="Continue" Click="NextClick" Style="{StaticResource AccentButton}" MinWidth="150" Height="44"/>
            </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>