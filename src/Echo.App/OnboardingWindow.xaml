<Window x:Class="Echo.App.OnboardingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Welcome to Echo" Width="720" Height="680" MinWidth="660" MinHeight="620" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource StudioFont}">
 <Grid Background="{DynamicResource BackgroundBrush}" Margin="38,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><DockPanel><TextBlock Text="Echo" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="StepNumber" DockPanel.Dock="Right" Text="1 / 5" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}"/></DockPanel><ProgressBar x:Name="Progress" Maximum="5" Value="1" Height="3" Margin="0,20,0,26"/><TextBlock x:Name="StepTitle" Text="Make it yours" FontSize="28" FontWeight="Bold"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,24,0,20">
   <Grid>
    <StackPanel x:Name="AppearanceStep">
     <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,10"/><ComboBox x:Name="ThemeChoice" SelectedIndex="0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Follow Windows"/></ComboBox>
     <TextBlock Text="Video quality" FontWeight="SemiBold" Margin="0,28,0,10"/><ComboBox x:Name="QualityChoice" SelectedIndex="3"><ComboBoxItem Content="720p · 30 FPS"/><ComboBoxItem Content="720p · 60 FPS"/><ComboBoxItem Content="1080p · 30 FPS"/><ComboBoxItem Content="1080p · 60 FPS"/></ComboBox>
    </StackPanel>
    <StackPanel x:Name="CaptureStep" Visibility="Collapsed">
     <TextBlock Text="What should Echo keep?" FontWeight="SemiBold" Margin="0,0,0,10"/><ComboBox x:Name="ModeChoice" SelectedIndex="0"><ComboBoxItem Content="Highlights only"/><ComboBoxItem Content="Entire match"/></ComboBox>
     <TextBlock Text="Capture source" FontWeight="SemiBold" Margin="0,28,0,10"/><ComboBox x:Name="SourceChoice" SelectedIndex="0"><ComboBoxItem Content="Game window"/><ComboBoxItem Content="Game monitor · fullscreen"/></ComboBox>
     <TextBlock Text="Monitor capture includes what is visible on the game's screen while League has focus." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel x:Name="HighlightsStep" Visibility="Collapsed">
     <TextBlock Text="Automatic highlights" FontWeight="SemiBold" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="KillsChoice" Content="Kills" IsChecked="True" Margin="0,0,30,0"/><CheckBox x:Name="AssistsChoice" Content="Assists" IsChecked="True" Margin="0,0,30,0"/><CheckBox x:Name="DeathsChoice" Content="Deaths" IsChecked="True"/></StackPanel>
     <Grid Margin="0,26,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Seconds before" Margin="0,0,0,9"/><TextBox x:Name="BeforeChoice" Text="15"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Seconds after" Margin="0,0,0,9"/><TextBox x:Name="AfterChoice" Text="8"/></StackPanel></Grid>
     <TextBlock Text="Manual clip shortcut" FontWeight="SemiBold" Margin="0,26,0,10"/><TextBox x:Name="ShortcutChoice" Text="Ctrl+Shift+F8" IsReadOnly="True" PreviewKeyDown="ShortcutKeyDown" ToolTip="Click and press a shortcut. Backspace clears it."/>
     <CheckBox x:Name="InputsChoice" Content="Record keyboard/mouse inputs for overlays" Margin="0,24,0,0"/>
    </StackPanel>
    <StackPanel x:Name="AudioStep" Visibility="Collapsed"><TextBlock Text="Audio sources" FontWeight="SemiBold" Margin="0,0,0,20"/><CheckBox x:Name="GameChoice" Content="Game audio" IsChecked="True" Margin="0,0,0,22"/><CheckBox x:Name="DesktopChoice" Content="All desktop audio" Margin="0,0,0,22"/><CheckBox x:Name="MicChoice" Content="Microphone"/><TextBlock Text="Desktop audio includes game sound." Style="{StaticResource Hint}" Margin="0,24,0,0"/></StackPanel>
    <StackPanel x:Name="StorageStep" Visibility="Collapsed"><TextBlock Text="Recording folder" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="FolderChoice" TextWrapping="Wrap"/><Button Content="Choose folder" Click="BrowseFolder" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock Text="Echo will detect League and record automatically when a match starts." Style="{StaticResource Hint}" Margin="0,32,0,0"/></StackPanel>
   </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="2"><TextBlock x:Name="SetupError" Foreground="#E77B8E" TextWrapping="Wrap" Margin="0,0,0,12"/><DockPanel><Button Content="Skip for now" Click="SkipClick" Style="{StaticResource QuietButton}" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BackButton" Content="Back" Click="BackClick" Style="{StaticResource QuietButton}" Margin="0,0,10,0" Visibility="Collapsed"/><Button x:Name="NextButton" Content="Continue" Click="NextClick" Style="{StaticResource AccentButton}" MinWidth="140"/></StackPanel></DockPanel></StackPanel>
 </Grid>
</Window>
